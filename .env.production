# Production-only Vite env — loaded automatically by `vite build`/`npm run build`. Committed
# (unlike `.env`) because the values below are public, same-origin static asset paths, not
# secrets. See .env.example for the full explanation of these variables and
# docs/detail-map-integration.md for the OSM PMTiles pipelines that produced both files.
VITE_DETAIL_MAP_SOURCE_URL=maps/daklak.pmtiles
VITE_DETAIL_MAP_SERVICES_URL=maps/daklak-services.pmtiles
