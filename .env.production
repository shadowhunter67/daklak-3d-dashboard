# Production-only Vite env — loaded automatically by `vite build`/`npm run build`. Committed
# (unlike `.env`) because the value below is a public, same-origin static asset path, not a
# secret. See .env.example for the full explanation of this variable and docs/detail-map-integration.md
# for the OSM roads/buildings/places PMTiles pipeline that produced public/maps/daklak.pmtiles.
VITE_DETAIL_MAP_SOURCE_URL=maps/daklak.pmtiles
