{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/shadowhunter67/daklak-3d-dashboard/data-templates/schemas/project-portfolio-bundle.schema.json",
  "description": "Canonical top-level bundle — Layer 1 (transport/structural) contract only. KHÔNG kiểm tra semantic record constraints (Layer 2 — validateProject.ts) hay cross-record/data-quality (Layer 3 — dataQualityRules.ts). Xem docs/project-data-import/02-canonical-schema-proposal.md, ADR 0006.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleVersion", "metadata", "datasets"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version của CẤU TRÚC bundle này. Việc version nào được CHẤP NHẬN chạy (allowlist) là quyết định runtime (isSupportedCanonicalSchemaVersion trong src/entities/project/canonicalBundle.ts), không phải hardcode trong schema — schema chỉ kiểm tra đây có phải một chuỗi semver hợp lệ hay không."
    },
    "bundleVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Version của MỘT LẦN xuất dữ liệu cụ thể — KHÔNG dùng timestamp làm giá trị này (xem schema-versioning-policy.md)."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "asOf",
        "sourceDatasetIds",
        "administrativeCodeVersion",
        "classification",
        "producer"
      ],
      "properties": {
        "generatedAt": { "$ref": "definitions/common.schema.json#/definitions/isoDateTime" },
        "asOf": { "$ref": "definitions/common.schema.json#/definitions/isoDateTime" },
        "sourceDatasetIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "administrativeCodeVersion": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "producer": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agencies",
        "contractors",
        "projects",
        "workPackages",
        "milestones",
        "projectIssues",
        "progressSnapshots",
        "evidence",
        "referenceDocuments"
      ],
      "properties": {
        "agencies": { "type": "array", "items": { "$ref": "definitions/agency.schema.json" } },
        "contractors": {
          "type": "array",
          "items": { "$ref": "definitions/contractor.schema.json" }
        },
        "projects": { "type": "array", "items": { "$ref": "definitions/project.schema.json" } },
        "workPackages": {
          "type": "array",
          "items": { "$ref": "definitions/work-package.schema.json" }
        },
        "milestones": {
          "type": "array",
          "items": { "$ref": "definitions/milestone.schema.json" }
        },
        "projectIssues": {
          "type": "array",
          "items": { "$ref": "definitions/project-issue.schema.json" }
        },
        "progressSnapshots": {
          "type": "array",
          "items": { "$ref": "definitions/progress-snapshot.schema.json" }
        },
        "evidence": { "type": "array", "items": { "$ref": "definitions/evidence.schema.json" } },
        "referenceDocuments": {
          "type": "array",
          "items": { "$ref": "definitions/reference-document.schema.json" }
        },
        "auditEvents": {
          "type": "array",
          "items": { "$ref": "definitions/project-audit-event.schema.json" },
          "description": "Optional/deferred — xem ADR 0006."
        }
      }
    }
  }
}
