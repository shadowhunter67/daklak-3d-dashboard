{
  "name": "daklak-3d-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "build:demo": "npm run build",
    "build:internal-static": "tsc -b && vite build --mode internal-static",
    "build:public-static": "tsc -b && vite build --mode public-static",
    "validate:portfolio-data-mode:demo": "node scripts/validate_portfolio_data_mode.mjs --expected-mode=demo",
    "validate:portfolio-data-mode:internal-static": "node scripts/validate_portfolio_data_mode.mjs --expected-mode=internal-static",
    "validate:portfolio-data-mode:public-static": "node scripts/validate_portfolio_data_mode.mjs --expected-mode=public-static",
    "verify:portfolio-data-modes": "npm run build:demo && npm run validate:portfolio-data-mode:demo && npm run build:internal-static && npm run validate:portfolio-data-mode:internal-static && npm run build:public-static && npm run validate:portfolio-data-mode:public-static",
    "check:budget": "node scripts/check_build_budget.mjs",
    "build:metrics": "node scripts/generate_build_metrics.mjs",
    "generate:public-manifest": "node scripts/generate_public_manifest.mjs",
    "validate:public-build": "node scripts/validate_public_build.mjs --mode=source",
    "validate:public-build:dist": "node scripts/validate_public_build.mjs --mode=dist",
    "validate:project-data-contract": "node scripts/validate_project_data_contract.mjs",
    "import:data": "tsx scripts/import-data/cli.ts",
    "stage:internal-portfolio": "tsx scripts/import-data/stage_internal_portfolio_bundle.ts",
    "project:public-data": "tsx scripts/public-projection/cli.ts",
    "project:public-data:release": "tsx scripts/public-projection/cli.ts --require-publication-decisions",
    "stage:public-portfolio": "tsx scripts/public-projection/stage_public_portfolio_bundle.ts",
    "stage:public-portfolio:release": "tsx scripts/public-projection/stage_public_portfolio_bundle.ts --require-approval-receipt",
    "test:public-projection": "vitest run src/entities/project/publicProjection scripts/public-projection",
    "benchmark:import-data": "tsx scripts/import-data/benchmark/run_benchmark.ts",
    "test:project-data-import": "vitest run scripts/import-data",
    "quality:frontend": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:project-data-import && npm run validate:project-data-contract && npm run generate:public-manifest && npm run validate:public-build && npm run build && npm run validate:public-build:dist && npm run check:budget && npm run build:metrics && npm run test:e2e:prod:built",
    "quality:full": "npm run check:gis-deps && npm run quality:frontend && npm run validate:data",
    "quality": "npm run quality:full",
    "check:gis-deps": "node scripts/check_gis_deps.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && playwright test --config=playwright.prod.config.ts",
    "test:e2e:prod:built": "playwright test --config=playwright.prod.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "node scripts/check_secrets.mjs",
    "prepare:gis-source": "python scripts/prepare_gis_source.py",
    "prepare:gis-source:offline": "python scripts/prepare_gis_source.py --offline",
    "validate:data": "python scripts/validate_daklak_data.py",
    "build:gis": "npm run prepare:gis-source && python scripts/build_daklak_geojson.py",
    "build:terrain": "python scripts/generate_daklak_terrain.py",
    "build:roads": "python scripts/build_daklak_roads.py"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^6.4.0",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
